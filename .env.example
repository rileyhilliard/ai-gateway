# Copy to .env locally; `bun run dev` and `bun run start` load it. Never commit secrets.
# Parsed by src/config.ts, which fails at startup naming any bad value.

# Port the server listens on. PORT is the fallback when PORT_API is unset (default 3000).
PORT_API=3000
# trace, debug, info (default), warn, error, fatal or silent; case doesn't matter.
LOG_LEVEL=info
# Largest request body in bytes before the 413 envelope (default 65536).
MAX_BODY_BYTES=65536
# Seed JSON with the company, tiers, employees and keys (default seed/company.json).
SEED_PATH=seed/company.json
# OpenRouter API key for real inference. Without it, non-fake models get the 502 envelope.
OPENROUTER_KEY=
# Admin key for /admin/usage and the /admin page, sent as x-admin-key. Unset means every admin
# request gets 401. http/admin.http uses the demo value dev-admin-key.
ADMIN_KEY=
# Demo only: 1 mounts POST /admin/clock/advance so a demo can skip to the next day or week.
DEMO_CLOCK=
